# В образ попадает только то, что нужно для запуска (bot.py + requirements.txt),
# но если Dockerfile когда-нибудь станет `COPY . .` — этот файл не даст утащить
# в образ секреты и локальные данные.
.git
.gitignore
.claude
.idea
.vscode
__pycache__
*.py[cod]
.venv
venv
.env
.env.*
sea_bot_data.json
hotels.db
*.db
*.md
selfcheck.py
hotels.py
