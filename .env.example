# Скопируй в .env и заполни своими значениями. Файл .env в git не попадает.
# Никогда не вставляй реальные токены в код, README, скриншоты или zip-архивы.

# ── Обязательно ──────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=

# ── Режим работы ─────────────────────────────────────────────────────────────
# Не задан → локальный polling (для запуска на своём компьютере).
# 1        → webhook-сервер на PORT (для Render/Cloud Run и подобных).
# На Render переменная RENDER выставляется платформой сама — можно не задавать.
WEBHOOK_MODE=
PORT=8080

# ── Защита Telegram webhook ─────────────────────────────────────────────────
# Обязательны, если WEBHOOK_MODE=1. Сгенерируй две РАЗНЫЕ строки:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Первая используется только в URL, вторая — в заголовке Telegram.
WEBHOOK_PATH_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# ── Секрет для внешнего крона (/cron/daily) ──────────────────────────────────
# Если пусто — эндпоинт открыт всем, кто знает URL, и любой желающий может
# разослать дайджест подписчикам. На публичном хостинге задай случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# и передавай её в заголовке X-Cron-Secret при вызове /cron/daily.
DAILY_CRON_SECRET=

# ── Хранилище подписчиков (опционально) ──────────────────────────────────────
# Без этих переменных данные лежат в локальном sea_bot_data.json и теряются
# при каждом перезапуске контейнера. Upstash Redis (REST API, бесплатный тариф)
# переживает перезапуски и не требует карты.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Имя ключа данных в Redis. Для этого независимого экземпляра оставь
# new_bot_data, чтобы не смешать подписки с исходным ботом.
UPSTASH_REDIS_KEY=new_bot_data
